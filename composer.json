{
    "name": "sergeybesck/call-calendar",
    "require": {
        "php": ">=8.3",
        "league/route": "7.0",
        "league/openapi-psr7-validator": "0.24",
        "nyholm/psr7": "1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "authors": [
        {
            "name": "Sergey.Besck",
            "email": "sergey.besck@gmail.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "lint": ["phpstan analyse --memory-limit=256M", "php-cs-fixer fix --dry-run --diff"]
    },
    "autoload": { "psr-4": { "App\\": "src/", "App\\Generated\\": "generated/" } },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jane-php/open-api-3": "8.0.1"
    }
}
