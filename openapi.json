{
  "openapi": "3.0.0",
  "info": {
    "title": "Calendar",
    "version": "1.0.0",
    "description": "Запись на звонок: типы событий, слоты, записи."
  },
  "tags": [
    {
      "name": "EventTypes"
    },
    {
      "name": "Slots"
    },
    {
      "name": "Bookings"
    }
  ],
  "paths": {
    "/bookings": {
      "post": {
        "operationId": "createBooking",
        "description": "Создание записи Гостем на свободный слот. 404 — тип события не найден.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Client error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingCreate"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listBookings",
        "description": "Предстоящие записи всех типов событий, отсортированы по start.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingsResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Bookings"
        ]
      }
    },
    "/event-types": {
      "get": {
        "operationId": "listEventTypes",
        "description": "Список типов событий: видит Гость и Хост.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "EventTypes"
        ]
      },
      "post": {
        "operationId": "createEventType",
        "description": "Создание типа события Хостом.",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The request has succeeded and a new resource has been created as a result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "EventTypes"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventTypeCreate"
              }
            }
          }
        }
      }
    },
    "/event-types/{id}": {
      "get": {
        "operationId": "getEventType",
        "description": "Детали типа события.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventType"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "EventTypes"
        ]
      }
    },
    "/event-types/{id}/slots": {
      "get": {
        "operationId": "listSlots",
        "description": "Слоты на окно записи (от текущего момента, округлённого вверх до 15 минут, до конца 14-го календарного дня в поясе приложения).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotsResponse"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Slots"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Booking": {
        "type": "object",
        "required": [
          "id",
          "eventTypeId",
          "eventTypeName",
          "start",
          "durationMinutes",
          "name",
          "email",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventTypeId": {
            "type": "string"
          },
          "eventTypeName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BookingCreate": {
        "type": "object",
        "required": [
          "eventTypeId",
          "start",
          "name",
          "email"
        ],
        "properties": {
          "eventTypeId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Slug выбранного типа события."
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало слота: ISO 8601 с обязательным смещением; без смещения — 400."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          }
        }
      },
      "BookingsResponse": {
        "type": "object",
        "required": [
          "timezone",
          "bookings"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA-идентификатор часового пояса приложения."
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          }
        }
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Slug-идентификатор, уникален."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Описание; null, если не задано."
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540,
            "description": "Длительность в минутах, 1..540 (длина рабочего дня)."
          }
        },
        "description": "Тип события: вид встречи, на который идёт запись."
      },
      "EventTypeCreate": {
        "type": "object",
        "required": [
          "id",
          "name",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "URI-идентификатор типа проблемы."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          }
        },
        "description": "Ошибка в формате RFC 9457 (application/problem+json)."
      },
      "Slot": {
        "type": "object",
        "required": [
          "start",
          "available"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "description": "Начало слота: ISO 8601 с обязательным смещением локального пояса приложения."
          },
          "available": {
            "type": "boolean"
          }
        },
        "description": "Слот: начало возможной записи в сетке календаря."
      },
      "SlotsResponse": {
        "type": "object",
        "required": [
          "timezone",
          "slots"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA-идентификатор часового пояса приложения, например Europe/Moscow."
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/api",
      "description": "Calendar API",
      "variables": {}
    }
  ]
}
